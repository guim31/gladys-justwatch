  "scene_triggers": [
    {
      "key": "new_title",
      "label": {
        "en": "JustWatch: new title on my platforms",
        "fr": "JustWatch : nouveau titre sur mes plateformes",
        "de": "JustWatch: neuer Titel auf meinen Plattformen",
        "es": "JustWatch: nuevo título en mis plataformas"
      },
      "description": {
        "en": "A film or a season arrived on a platform of a list, seen at the next reading.",
        "fr": "Un film ou une saison est arrivé sur une plateforme d’une liste, vu à la lecture suivante.",
        "de": "Ein Film oder eine Staffel ist auf einer Plattform einer Liste angekommen, beim nächsten Abruf gesehen.",
        "es": "Una película o una temporada llegó a una plataforma de una lista, vista en la siguiente lectura."
      },
